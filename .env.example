# WebinarAI Environment Configuration Template
# Copy this file to .env and configure your local settings.
# NEVER commit real credentials or .env to version control!

# Flask Application Settings
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=replace-with-a-secure-random-secret-key
PORT=5000

# Database Configuration (MySQL Community Server on localhost:3306)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=webinar_ai_db
DB_USER=root
DB_PASSWORD=your_local_mysql_password

# Google Gemini API (Prompt 5)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# SMTP Email Delivery Settings (Prompt 7)
# -------------------------------------------------------------
# For Gmail SMTP:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USE_TLS=True
#   SMTP_USE_SSL=False
#   SMTP_USERNAME=your_gmail_address@gmail.com
#   SMTP_PASSWORD=your_16_character_google_app_password
#   SMTP_FROM_EMAIL=your_gmail_address@gmail.com
#   SMTP_FROM_NAME=WebinarAI Platform
#
# Note for Gmail:
#   1. Google requires 2-Step Verification to be enabled on your Google Account.
#   2. Navigate to myaccount.google.com -> Security -> 2-Step Verification -> App passwords.
#   3. Generate a 16-character App Password for "Mail" / "Other (WebinarAI)".
#   4. Use that 16-character app password in SMTP_PASSWORD (without spaces).
#   5. Owning a Gemini Pro subscription does NOT automatically grant a Google Workspace account.
#   6. For SSL connections (e.g. port 465), set SMTP_USE_TLS=False and SMTP_USE_SSL=True.
# -------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
SMTP_USE_TLS=True
SMTP_USE_SSL=False
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=WebinarAI Platform
SMTP_TIMEOUT=15
